{
  "name": "stockindicators.dev",
  "type": "module",
  "engines": {
    "node": ">=26"
  },
  "devEngines": {
    "runtime": {
      "name": "node",
      "version": "26",
      "onFail": "download"
    }
  },
  "packageManager": "pnpm@12.18.0",
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "preview": "astro preview",
    "typecheck": "tsc",
    "lint": "pnpm run format:check && pnpm run lint:eslint && pnpm run lint:md",
    "lint:fix": "pnpm run format && pnpm run lint:eslint:fix && pnpm run lint:md:fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint:md": "pnpm exec markdownlint-cli2",
    "lint:md:fix": "pnpm exec markdownlint-cli2 --fix",
    "lint:eslint": "eslint \"**/*.{js,ts,astro}\" --cache --max-warnings=0",
    "lint:eslint:fix": "eslint \"**/*.{js,ts,astro}\" --fix --cache"
  },
  "dependencies": {
    "@astrojs/sitemap": "^3.7.6",
    "astro": "^7.4.13"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@typescript/native": "npm:typescript@^7.0.2",
    "eslint": "^10.15.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-astro": "^3.2.1",
    "jiti": "^2.7.0",
    "markdownlint-cli2": "^0.24.2",
    "prettier": "^3.10.1",
    "prettier-plugin-astro": "^1.1.2",
    "sass": "^1.108.2",
    "typescript": "npm:@typescript/typescript6@^6.0.2",
    "typescript-eslint": "^8.73.0"
  }
}
